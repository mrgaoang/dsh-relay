# ============================================================================
# dsh-relay TURN 服务器 — NAS(家庭宽带)生产配置模板
# ----------------------------------------------------------------------------
# 实测环境:fnOS NAS(192.168.1.30)+ 光猫 SK-D847N(动态公网 IP + DDNS)
# 部署全流程见 docs/TURN-PLAN.md 第 12 节。
#
# 用法:
#   1. 复制为 turnserver.conf,替换占位符:
#      - <PUBLIC_IP>       路由器 WAN 公网 IP(动态 IP 需 DDNS 更新脚本)
#      - <NAS_LAN_IP>      NAS 内网 IP(如 192.168.1.30)
#      - <TURN_SECRET>     与 relay-enterprise 的 DSH_ENTERPRISE_TURN_SECRET 相同
#      - <DOMAIN>          建议域名(如 n.risegao.cn)
#   2. chmod 644(容器以 nobody 运行,600 会报 Cannot find config file)
#   3. docker compose up -d(同目录 docker-compose.yml,host 网络)
#   4. 光猫端口转发:3479/udp+tcp、34810-34829/udp → <NAS_LAN_IP>
# ============================================================================

# ---------- 监听端口(NAS 与 relay-core STUN 3478 共存,改听 3479) ----------
listening-port=3479
# 只绑物理网卡,避免绑到 docker 网桥 172.x
listening-ip=<NAS_LAN_IP>
relay-ip=<NAS_LAN_IP>
# TLS/DTLS 需证书,未配置则不开(生产可补 Let's Encrypt)
# tls-listening-port=5349

# ---------- 公网映射(NAS 在家庭 NAT 后,必须显式配置) ----------
external-ip=<PUBLIC_IP>/<NAS_LAN_IP>

# ---------- 中继端口池(光猫逐条转发 34810-34829/udp) ----------
min-port=34810
max-port=34829

# ---------- 认证:TURN REST API(与 relay-enterprise 签发凭证配合) ----------
# use-auth-secret 隐含 lt-cred-mech,不要重复写 lt-cred-mech(会告警)
use-auth-secret
static-auth-secret=<TURN_SECRET>
realm=<DOMAIN>

# ---------- 消息指纹 ----------
fingerprint

# ---------- 配额与限速(与 relay-enterprise 套餐治理配合) ----------
total-quota=100
user-quota=5
max-bps=250000

# ---------- 日志 ----------
log-file=stdout

# ---------- 安全加固 ----------
no-multicast-peers
no-tcp-relay
# 防 TURN 被当内网探测跳板:拒绝中继到 RFC1918/保留地址
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=169.254.0.0-169.254.255.255

# ---------- 监控(50GB/月 用量统计,可选) ----------
# prometheus
# prometheus-username-labels
# prometheus-port=9641
